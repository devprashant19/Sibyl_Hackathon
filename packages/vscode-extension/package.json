{
  "name": "sibyl-vscode",
  "displayName": "Sibyl Chaos Engine",
  "description": "Continuous Reliability and Chaos Engineering directly in your IDE.",
  "version": "1.0.0",
  "publisher": "sibyl-dev",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:javascript"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sibyl.runLocal",
        "title": "Sibyl: Run Local Simulation"
      }
    ],
    "configuration": {
      "title": "Sibyl",
      "properties": {
        "sibyl.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to the sibyl CLI. Empty: use node_modules/.bin/sibyl found above the config, else `sibyl` on PATH."
        },
        "sibyl.defaultIterations": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "description": "Passed as -n to `sibyl run`. Empty: use the config's iterations."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "sibyl",
        "required": [
          "config"
        ],
        "properties": {
          "config": {
            "type": "string",
            "description": "Path to sibyl.config.ts"
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.0.0"
  }
}
